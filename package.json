    "test": "node --test --import tsx --experimental-sqlite tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "undici": "^7.19.0"
  }
}
