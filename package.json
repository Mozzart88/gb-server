{
  "name": "exchange-api",
  "version": "1.0.0",
  "description": "Minimal currency exchange API server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node --experimental-sqlite dist/index.js",
